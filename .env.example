# ---- Database (docker compose builds DATABASE_URL from these) ----
POSTGRES_USER=icecap
POSTGRES_PASSWORD=change-me
POSTGRES_DB=icecap
# For running the worker/app outside Docker:
# DATABASE_URL=postgresql://icecap:change-me@localhost:5432/icecap

# ---- Ingestion ----
ICECAP_BACKFILL_DAYS=365
ICECAP_MAX_CONCURRENT_SOURCES=3
ICECAP_SCHEDULER_TICK_S=15
# Identify yourself to the City's servers (recommended: include a contact URL or email you control)
ICECAP_USER_AGENT=IceCapDevelopmentIntelligence/0.1 (public-records monitor)

# ---- Notifications (leave blank => mocked delivery, clearly marked "mocked" in the dashboard) ----
NOTIFY_CHANNELS=telegram,email
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Link used inside alerts
DASHBOARD_URL=http://localhost:3000
